# Generated by install.sh — edit infra/install/nginx.conf.tmpl and re-run
# `./install.sh install` instead of editing this file. certbot adds the 443
# listeners and HTTP->HTTPS redirects in place when TLS is enabled.

map $http_upgrade $vichar_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream vichar_ui      { server 127.0.0.1:__UI_PORT__; }
upstream vichar_docs    { server 127.0.0.1:__DOCS_PORT__; }
upstream vichar_gateway { server 127.0.0.1:__GATEWAY_PORT__; }
upstream vichar_api     { server 127.0.0.1:__API_PORT__; }
upstream vichar_admin   { server 127.0.0.1:__ADMIN_PORT__; }

server {
    listen 80;
    server_name __APP_DOMAIN__;
    include /etc/nginx/snippets/vichar-security-headers.conf;
    client_max_body_size 25m;

    location / {
        proxy_pass http://vichar_ui;
        include /etc/nginx/snippets/vichar-proxy.conf;
    }
}

server {
    listen 80;
    server_name __DOCS_DOMAIN__;
    include /etc/nginx/snippets/vichar-security-headers.conf;
    client_max_body_size 25m;

    location / {
        proxy_pass http://vichar_docs;
        include /etc/nginx/snippets/vichar-proxy.conf;
    }
}

# api domain: inference/public prefixes go to the gateway, everything else
# (auth, dashboard API, admin API) to the api.
server {
    listen 80;
    server_name __API_DOMAIN__;
    include /etc/nginx/snippets/vichar-security-headers.conf;
    client_max_body_size 100m;

    location /metrics { return 404; }
    location /docs    { return 404; }
    location /json    { return 404; }

    location ~ ^/(v1/(chat|embeddings|images|key|models|moderations|ocr|rerank|systemone|messages|responses|audio|realtime|videos|credits|ai)|v[2-4]/ai|mcp|oauth/|\.well-known/|openapi\.json$|robots\.txt$) {
        proxy_pass http://vichar_gateway;
        include /etc/nginx/snippets/vichar-proxy.conf;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location / {
        proxy_pass http://vichar_api;
        include /etc/nginx/snippets/vichar-proxy.conf;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name __ADMIN_DOMAIN__;
    include /etc/nginx/snippets/vichar-security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 10m;

    location / {
        proxy_pass http://vichar_admin;
        include /etc/nginx/snippets/vichar-proxy.conf;
    }
}
