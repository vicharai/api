{
	"name": "llmgateway",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"benchmark": "pnpm --filter @llmgateway/benchmarks benchmark",
		"build": "TURBO_TOKEN=turbotokenoss turbo run build 2>&1",
		"build:ci": "TURBO_TOKEN=turbotokenoss turbo run build --concurrency=1 2>&1",
		"build:core": "TURBO_TOKEN=turbotokenoss turbo run build --filter=!ui --filter=!docs --filter=!playground --filter=!admin --filter=!code --filter=!airside",
		"clean": "find . -path \"./node_modules\" -prune -o \\( -type d -name \"dist\" -o -name \".turbo\" -o -name \".source\" -o -name \".vercel\" -o -name \".out\" -o -name \".next-dev\" -o -name \".next\" \\) -exec rm -rf {} +",
		"clean:node_modules": "find . -type d -name \"node_modules\" -exec rm -rf {} +",
		"dev": "turbo run dev",
		"format": "turbo run format 2>&1",
		"postinstall": "husky",
		"lint": "turbo run lint",
		"license:issue": "tsx scripts/internal/issue-enterprise-license.ts",
		"migrate": "pnpm --filter db migrate",
		"migrations": "pnpm --filter db migrations",
		"prepare-codex": "mv ~/.nvm ~/.nvm-bak && export PATH=\"${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH\" && . ~/.bashrc && sudo service postgresql start && sudo service redis-server start && sleep 20 && pnpm sync",
		"push": "pnpm push-dev && pnpm push-test",
		"push-dev": "pnpm --filter db push",
		"push-test": "DATABASE_URL=${TEST_DATABASE_URL:-${DATABASE_URL:-postgres://postgres:pw@localhost:5432/test}} pnpm --filter db push",
		"seed": "pnpm --filter db seed",
		"seed-demo": "pnpm --filter db seed-demo",
		"setup": "pnpm build:core && docker compose down -v && docker compose up -d && pnpm wait-for-services && pnpm push-test && pnpm push-dev && pnpm seed",
		"sync": "pnpm push-dev; pnpm push-test",
		"stripe:listen": "stripe listen --api-key \"$(grep -E '^STRIPE_SECRET_KEY=' .env | head -1 | cut -d= -f2-)\" --forward-to localhost:4002/stripe/webhook",
		"test:browser": "playwright test",
		"test:e2e": "pnpm build:core && E2E_TEST=true vitest run -c vitest/vitest.e2e.config.mts --no-file-parallelism",
		"test:unit": "pnpm build:core && vitest run --no-file-parallelism",
		"wait-for-services": "./scripts/wait-for-services.sh"
	},
	"commitlint": {
		"extends": "@steebchen/commitlint-config"
	},
	"prettier": "@steebchen/prettier-config",
	"devDependencies": {
		"@abinnovision/eslint-config-react": "3.1.1",
		"@playwright/test": "1.61.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/npm": "^13.1.5",
		"@steebchen/commitlint-config": "^1.7.0",
		"@steebchen/eslint-config": "^1.11.1",
		"@steebchen/lint-base": "1.1.0",
		"@steebchen/prettier-config": "^1.5.0",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "26.2.0",
		"commitlint": "21.2.2",
		"concurrently": "^10.0.4",
		"dotenv": "17.4.2",
		"esbuild-fix-imports-plugin": "1.0.23",
		"eslint": "^9.34.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-no-relative-import-paths": "1.6.1",
		"husky": "^9.1.7",
		"lint-staged": "16.4.0",
		"nodemon": "3.1.14",
		"prettier": "^3.9.6",
		"resolve-tspaths": "0.8.23",
		"semantic-release": "^24.2.5",
		"semantic-release-monorepo": "8.0.2",
		"sort-package-json": "3.4.0",
		"sql.js": "1.13.0",
		"tsc-watch": "7.2.0",
		"tsx": "4.22.4",
		"turbo": "^2.9.14",
		"typescript": "5.9.2",
		"vite": "^7.3.5",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.11",
		"webreel": "0.1.4"
	},
	"disabledLinters": [
		"eslint-plugin-tailwindcss"
	],
	"dependencies": {
		"canvas-confetti": "1.9.4"
	}
}
