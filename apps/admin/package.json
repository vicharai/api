{
	"name": "admin",
	"version": "0.0.0",
	"private": true,
	"license": "SEE LICENSE IN ../../LICENSE",
	"files": [
		"public",
		".next"
	],
	"scripts": {
		"build": "pnpm generate && next build --turbopack && tsc && mkdir -p .next/static && cp -r .next/static .next/standalone/apps/admin/.next/ && cp -r public .next/standalone/apps/admin/",
		"dev": "next dev --port ${ADMIN_PORT:-3006} --turbopack",
		"format": "eslint --fix . && prettier --write .",
		"generate": "openapi-typescript ../api/openapi.json -o ./src/lib/api/v1.d.ts",
		"lint": "eslint . && prettier --check .",
		"start": "next start --port ${ADMIN_PORT:-3006}"
	},
	"dependencies": {
		"@better-auth/passkey": "1.6.26",
		"@llmgateway/shared": "workspace:*",
		"@tailwindcss/postcss": "4.1.16",
		"@tanstack/react-query": "^5.90.5",
		"@tanstack/react-table": "^8.21.3",
		"api": "workspace:*",
		"babel-plugin-react-compiler": "1.0.0",
		"better-auth": "1.6.26",
		"class-variance-authority": "0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "4.1.0",
		"lucide-react": "^0.548.0",
		"next": "16.3.4",
		"next-themes": "^0.4.6",
		"openapi-fetch": "0.15.0",
		"openapi-react-query": "0.5.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"recharts": "^2.15.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.16",
		"tailwindcss-animate": "1.0.7"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"openapi-typescript": "7.10.1",
		"postcss": "^8.5.26"
	}
}
