9:["$","h2","9",{"id":"2-ai-provider-sub-processors","children":["2. AI Provider Sub-processors"]}]
a:["$","p","10",{"children":["When you route a request, its content is transmitted to the AI provider serving the model you selected, so that provider can generate a response. Those providers act as sub-processors for that request."]}]
b:["$","p","11",{"children":["Because the provider catalogue changes continuously as models are added, deprecated and repriced, we do not reproduce it here, since a copy in this document would be out of date within days. The ",["$","strong","1",{"children":["live, authoritative list is published on our ",["$","a","1",{"href":"/legal/providers","children":["Provider Information page"]}]]}],", which shows, for every publicly identified provider we route to:"]}]
c:["$","ul","12",{"children":[["$","li","0",{"children":["its contracting entity, legal terms, privacy policy and usage policy,"]}],["$","li","1",{"children":["its headquarters and available processing regions,"]}],["$","li","2",{"children":["its data-retention window,"]}],["$","li","3",{"children":["whether it uses API inputs for model training,"]}],["$","li","4",{"children":["and its published certifications (for example SOC 2 or ISO 27001)."]}]]}]
d:["$","p","13",{"children":[["$","strong","0",{"children":["You choose which of these sub-processors process your data."]}]," No AI provider receives your request unless you select a model it serves, or enable automatic routing. Two controls let you constrain this:"]}]
e:["$","ul","14",{"children":[["$","li","0",{"children":[["$","strong","0",{"children":["Provider pinning:"]}]," address a model as ",["$","code","2",{"children":"provider/model"}]," to send it to exactly one provider, and send the ",["$","code","4",{"children":"x-no-fallback: true"}]," header to prevent failover to any other."]}],["$","li","1",{"children":[["$","strong","0",{"children":["Compliance policies:"]}]," Enterprise customers can restrict routing by the provider's published compliance and data-handling posture. Requests that cannot be served by an eligible provider are rejected rather than silently routed elsewhere."]}]]}]
f:["$","h3","15",{"id":"undisclosed-stealth-providers","children":["Undisclosed (\"stealth\") providers"]}]
10:["$","p","16",{"children":["Some providers serve preview or unreleased models under confidentiality and their identity is not disclosed to us or to you. These are listed on the Provider Information page under their pseudonymous names. As stated in our ",["$","a","1",{"href":"/legal/privacy","children":["Privacy Policy"]}],", we cannot verify or guarantee their data-handling practices, and we do not represent that they meet the standards the named providers do."]}]
11:["$","p","17",{"children":[["$","strong","0",{"children":["If you process personal data, or data subject to the GDPR, you should not rely on undisclosed providers."]}]," Pin your requests to named providers, or use a compliance policy that excludes providers without a published data policy."]}]
12:["$","hr","18",{}]
13:["$","h2","19",{"id":"3-changes-to-this-list","children":["3. Changes to This List"]}]
14:["$","p","20",{"children":["We notify customers ",["$","strong","1",{"children":["at least 30 days before"]}]," a new sub-processor in Section 1 begins processing personal data, giving you time to object."]}]
15:["$","p","21",{"children":["That notice period applies to the operational sub-processors in Section 1. It does ",["$","strong","3",{"children":["not"]}]," apply to the AI providers in Section 2: those are added continuously, and none of them receives your data unless you select a model it serves or leave automatic routing enabled. Customers who need advance notice for AI providers should use a compliance policy or provider pinning, which turn provider selection into an explicit allowlist under your control."]}]
16:["$","p","22",{"children":["To receive sub-processor change notices, email ",["$","strong","2",{"children":[["$","a","0",{"href":"mailto:contact@vichar.io","children":["contact@vichar.io"]}]]}]," and ask to be added to the sub-processor notification list."]}]
17:["$","h3","23",{"id":"objecting-to-a-sub-processor","children":["Objecting to a sub-processor"]}]
18:["$","p","24",{"children":["If you object to a new sub-processor on reasonable data-protection grounds, email us within the notice period. We will work with you to make the Service available without that sub-processor where technically feasible. If we cannot, you may terminate the affected part of the Service and receive a refund of your remaining unused prepaid credits."]}]
