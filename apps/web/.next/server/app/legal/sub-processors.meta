{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/legal/layout,_N_T_/legal/[slug]/layout,_N_T_/legal/[slug]/page,_N_T_/legal/sub-processors"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/legal/$d$slug/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 96,
        "slots": {
          "children": {
            "hints": 96,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  }
}