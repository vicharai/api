a:["$","p","20",{"children":["We use ",["$","strong","1",{"children":["Dodo Payments"]}]," to process payments as our merchant of record. Your payment data is handled by Dodo Payments under their ",["$","a","3",{"href":"https://dodopayments.com/privacy","children":["Privacy Policy"]}],". ",["$","strong","5",{"children":["We do not store your full credit card information."]}]]}]
b:["$","h3","21",{"id":"e-cookies-and-analytics","children":["e. Cookies and Analytics"]}]
