0:{"buildId":"0Vkc4BkTHIiLQc2dG6JEB","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"mx-auto max-w-[760px] px-5 py-16 sm:px-8 sm:py-24","children":[["$","nav",null,{"className":"flex gap-4 text-sm","aria-label":"Legal pages","children":[["$","$L2","terms",{"href":"/legal/terms/","className":"text-muted-foreground hover:text-foreground","children":"Terms of Use"}],["$","$L2","privacy",{"href":"/legal/privacy/","className":"font-medium text-foreground","aria-current":"page","children":"Privacy Policy"}],["$","$L2","sub-processors",{"href":"/legal/sub-processors/","className":"text-muted-foreground hover:text-foreground","children":"Sub-processors"}]]}],["$","h1",null,{"className":"mt-8 font-display text-4xl font-semibold tracking-tight","children":"Privacy Policy"}],["$","article",null,{"className":"prose prose-neutral dark:prose-invert mt-10 max-w-none text-[15px]","children":[["$","div","outer",{"children":[["$","p","0",{"children":[["$","strong","0",{"children":["Effective Date:"]}]," October 21, 2025",["$","br","2",{}],["$","strong","3",{"children":["Last Updated:"]}]," August 20, 2026"]}],["$","p","1",{"children":["Vichar (“we”, “our”, or “us”) provides a unified AI gateway platform that enables users to connect, manage, and analyze AI models across multiple providers. This Privacy Policy explains how we collect, use, share, and protect personal information when you use our website, APIs, SDKs, dashboards, and related services (collectively, the “Service”)."]}],["$","p","2",{"children":["This Policy is incorporated into and subject to our ",["$","a","1",{"href":"https://app.vichar.io/terms","children":["Terms of Use"]}],". Capitalized terms not defined here have the meaning given in the Terms."]}],["$","hr","3",{}],["$","h2","4",{"id":"1-our-role-controller-and-processor","children":["1. Our Role: Controller and Processor"]}],["$","p","5",{"children":["Our role depends on the data involved:"]}],["$","ul","6",{"children":[["$","li","0",{"children":[["$","strong","0",{"children":["As a controller."]}]," For account, billing, website, and usage-analytics data, we determine the purposes and means of processing and act as the ",["$","strong","3",{"children":["data controller"]}],"."]}],["$","li","1",{"children":[["$","strong","0",{"children":["As a processor / service provider."]}]," For the prompts, inputs, and content you submit to be routed to AI providers (“Customer Data”), we act as a ",["$","strong","2",{"children":["processor"]}]," (under GDPR) and a ",["$","strong","4",{"children":["service provider"]}]," (under the CCPA) on your behalf. You are responsible, as controller, for the Customer Data you submit and for having a lawful basis to submit it. Enterprise customers may enter into a separate ",["$","strong","6",{"children":["Data Processing Addendum (DPA)"]}]," that governs this processing; where a signed DPA exists, it controls over this Policy with respect to Customer Data."]}]]}],["$","p","7",{"children":["We ",["$","strong","1",{"children":["do not use Customer Data (your prompts, inputs, or the responses returned to you) to train any models."]}]," Customer Data is processed solely to provide the Service and according to your retention settings."]}],["$","hr","8",{}],["$","h2","9",{"id":"2-information-we-collect","children":["2. Information We Collect"]}],["$","h3","10",{"id":"a-account-information","children":["a. Account Information"]}],["$","p","11",{"children":["When you register, we collect your ",["$","strong","1",{"children":["name"]}],", ",["$","strong","3",{"children":["email address"]}],", and ",["$","strong","5",{"children":["organization details"]}],". For paid and enterprise users, we may also collect billing details such as company name, address, and payment information (payments are processed by ",["$","strong","7",{"children":["Dodo Payments"]}],", our merchant of record)."]}],["$","h3","12",{"id":"b-usage-data","children":["b. Usage Data"]}],"$L3","$L4","$L5","$L6","$L7","