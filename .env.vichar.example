# =============================================================================
# Vichar — unified-container environment (app.vichar.io / api.vichar.io)
#
# Copy to .env.vichar (same directory as this file, i.e. the repo root), fill in
# the __GENERATE__ / FILL-IN values on the SERVER, and keep it private:
#   cp .env.vichar.example .env.vichar && chmod 600 .env.vichar
# .env.vichar is loaded by infra/docker-compose.vichar.yml via env_file and is
# gitignored — never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# URLs — browser-facing (public via nginx) vs in-container
# -----------------------------------------------------------------------------
UI_URL=https://app.vichar.io
APP_URL=https://app.vichar.io
API_URL=https://api.vichar.io
GATEWAY_URL=https://api.vichar.io
DOCS_URL=https://docs.vichar.io

# Server-side API calls stay inside the container (api listens on :4002).
# The admin container overrides this with http://vichar-app-<colour>:4002
# (set by vichar-deploy / the compose `admin` service), since it has no api.
API_BACKEND_URL=http://localhost:4002

# Admin panel (apps/admin, own container). The UI's /admin redirects here and
# the api trusts it for passkeys. The admin app reads API_URL, API_BACKEND_URL
# and UI_URL from this same file.
ADMIN_URL=https://admin.vichar.io

# CORS + better-auth trusted origins (and passkey origins): the UI and admin.
ORIGIN_URLS=https://app.vichar.io,https://admin.vichar.io
GATEWAY_CORS_ORIGINS=https://app.vichar.io

# -----------------------------------------------------------------------------
# Auth & security
# -----------------------------------------------------------------------------
# Generate each of these on the server, e.g.: openssl rand -base64 32
AUTH_SECRET=__GENERATE__
GATEWAY_API_KEY_HASH_SECRET=__GENERATE__

# Comma-separated owner admins for https://admin.vichar.io. Owners always have
# the full "admin" role; further staff get admin/support/viewer roles in the
# panel's Team page.
# Admin accounts are NOT auto-verified at signup (otherwise anyone could claim
# an unregistered address listed here). Sign up first, then verify once via:
#   UPDATE "user" SET email_verified = true WHERE email = 'admin@yourdomain.com'
# >>> FILL IN on the server <<<
ADMIN_EMAILS=admin@yourdomain.com

# Session cookies are shared across app / api / admin .vichar.io subdomains.
COOKIE_DOMAIN=.vichar.io

# WebAuthn/passkeys (must be the registrable domain, not a subdomain).
PASSKEY_RP_ID=vichar.io
PASSKEY_RP_NAME=Vichar

SSO_ENABLED=false
TELEMETRY_ACTIVE=false

# -----------------------------------------------------------------------------
# Database / Redis
# -----------------------------------------------------------------------------
# Postgres + redis run INSIDE the same container; the image defaults are fine
# (DATABASE_URL=postgres://postgres:llmgateway@localhost:5432/llmgateway,
# REDIS_HOST=localhost, REDIS_PORT=6379). Postgres binds localhost inside the
# container and uses trust auth (any in-container/local connection is trusted),
# so POSTGRES_PASSWORD is cosmetic today — do not rely on it for isolation;
# the redis host port 8381 is loopback-only inspection.
# To harden postgres auth later you must change initdb/pg_hba AND set both:
# POSTGRES_PASSWORD=__GENERATE__
# DATABASE_URL=postgres://postgres:<password>@localhost:5432/llmgateway

# Migrations run on container start — keep enabled.
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Rate limits — MVP defaults.
# Gateway enforces these; api reads the same values for dashboard display —
# in the unified container both processes share this file so they stay in sync.
# Uncomment to override (defaults shown in .env.example).
# -----------------------------------------------------------------------------
# GATEWAY_RATE_LIMITS_ENABLED=true
# GATEWAY_RATE_LIMIT_CHAT_COMPLETIONS_RPM=120
# GATEWAY_RATE_LIMIT_MESSAGES_RPM=120
# GATEWAY_RATE_LIMIT_RESPONSES_RPM=120
# GATEWAY_RATE_LIMIT_EMBEDDINGS_RPM=300
# GATEWAY_RATE_LIMIT_MODELS_RPM=300
# GATEWAY_MAX_INFLIGHT_REQUESTS=500
# GATEWAY_ORG_INFLIGHT_LIMIT_DEV=25

# Restricts the public catalogue to the curated vichar-* entries — listing and
# chat-completions dispatch. Without it, any configured provider key (including
# the :4499 mock upstream) would make that provider's full upstream catalogue
# callable at list prices. Comma-separated ids; `*` suffix = prefix match only.
# Free models carry the vichar- prefix too (vichar-…-free), so vichar-* covers
# them — a `*-free` suffix glob would never match.
GATEWAY_MODEL_ALLOWLIST=vichar-*

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# OpenRouter is the ONLY real provider in stage 1.
# >>> FILL IN on the server — never commit real values <<<
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare AI Gateway — stealth provider (hidden from the public provider
# list, upstream details redacted from errors). Requests go to the unified
# OpenAI-compatible endpoint on api.cloudflare.com with models sent as
# "<provider>/<model>". Requires a Cloudflare API token with Workers AI
# permissions. >>> FILL IN on the server — never commit real values <<<
LLM_CLOUDFLARE_API_KEY=
# Optional: override the account id (defaults to the platform account).
# LLM_CLOUDFLARE_ACCOUNT_ID=a35ce5c69b1c90b9692353eba6d89560
# Optional: override the whole account-scoped base URL
# (https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1).
# LLM_CLOUDFLARE_BASE_URL=
# Optional: route through a named AI Gateway instead of the account default.
# LLM_CLOUDFLARE_GATEWAY_ID=

# Free-tier safety budget: caps the daily platform spend on the paid
# Cloudflare fallback leg of `:free` models (USD/day). Once reached, free
# requests skip the Cloudflare leg until the counter resets at end of day.
# FREE_CF_DAILY_BUDGET_USD=5

# NVIDIA via the Cloudflare AI Gateway custom provider (slug nv) attached to
# the named gateway below — same stealth posture as cloudflare. The key is a
# Cloudflare API token with AI Gateway access; the NVIDIA BYOK key lives on
# the gateway itself. >>> FILL IN on the server — never commit real values <<<
LLM_NVIDIA_API_KEY=
# Optional: override the Cloudflare account id (defaults to the platform one).
# LLM_NVIDIA_ACCOUNT_ID=a35ce5c69b1c90b9692353eba6d89560
# Optional: named AI Gateway holding the nv custom provider (default vapi).
# LLM_NVIDIA_GATEWAY_ID=vapi
# Optional: override the whole gateway-scoped base URL
# (https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/custom-nv).
# LLM_NVIDIA_BASE_URL=

# -----------------------------------------------------------------------------
# Free-tier provider pools (stealth — serve the `:free` models)
# -----------------------------------------------------------------------------
# Every pool has its own LLM_<NAME>_FREE_API_KEY — free-tier keys live in
# dedicated vars so paid provider credentials never double as pool access.
# Do NOT set the paid names here: LLM_GROQ_API_KEY and
# LLM_GOOGLE_AI_STUDIO_API_KEY belong to the paid `groq` /
# `google-ai-studio` providers, and setting either activates that
# provider's paid catalogue (see the NEVER-set warning below).
# nvidia-free takes its own NVIDIA NGC key (nvapi-…, build.nvidia.com) for the
# direct integrate.api.nvidia.com pool — do NOT reuse LLM_NVIDIA_API_KEY,
# which is the Cloudflare token for the `nvidia` vapi provider.
# opencode-free is wired but currently serves no model legs: its free tier is
# client-locked ("can only be used from within OpenCode") and 403s API calls.
# >>> FILL IN on the server — never commit real values <<<
LLM_NVIDIA_FREE_API_KEY=
LLM_OPENROUTER_FREE_API_KEY=
LLM_OPENCODE_FREE_API_KEY=
LLM_KILO_FREE_API_KEY=
LLM_GROQ_FREE_API_KEY=
LLM_GOOGLE_FREE_API_KEY=
# Optional: base-URL overrides (defaults are the upstream free endpoints).
# LLM_NVIDIA_FREE_BASE_URL=
# LLM_OPENROUTER_FREE_BASE_URL=
# LLM_OPENCODE_FREE_BASE_URL=
# LLM_KILO_FREE_BASE_URL=
# LLM_GROQ_FREE_BASE_URL=
# LLM_GOOGLE_FREE_BASE_URL=

# AWS Bedrock — prepared code path, NOT currently configured or tested.
# Leave the key empty until the mapping is validated end to end.
LLM_AWS_BEDROCK_API_KEY=
# LLM_AWS_BEDROCK_REGION=us-east-1
# Only set BASE_URL to a dead endpoint to simulate provider failure for
# failover testing; leave commented for production.
# LLM_AWS_BEDROCK_BASE_URL=

# NEVER set LLM_OPENAI_* (or any other LLM_*_API_KEY) on this deployment unless
# a real upstream key is configured. Any provider with credentials present is
# advertised as "configured" and its catalogue models become selectable and
# billable. The mock OpenAI upstream used for failover testing lives in the
# staging overlay (infra/docker-compose.vichar-staging.yml) — it must never
# run in production.

# -----------------------------------------------------------------------------
# Deliberately UNSET for stage 1 (documented so nobody "fixes" it later)
# -----------------------------------------------------------------------------
# DODO_PAYMENTS_*    — billing stays off until the owner adds real Dodo keys
#                      (and DODO_CREDITS_PRODUCT_ID / DODO_AUTO_TOPUP_PRODUCT_ID);
#                      billing endpoints return 503 while unset.
# RESEND_*            — transactional email disabled; signup auto-verifies
#                       because HOSTED is unset (non-hosted mode skips the
#                       email-verification requirement). When enabling mail
#                       later, set RESEND_API_KEY and optionally
#                       RESEND_FROM_EMAIL (defaults to
#                       "Vichar <noreply@vichar.io>") and
#                       RESEND_REPLY_TO_EMAIL (defaults to contact@vichar.io).
# HOSTED              — leave unset (this is a self-hosted-style deployment).
# EMAIL_FOLLOW_UPS    — leave false (worker only logs lifecycle events).
EMAIL_FOLLOW_UPS=false
# LLMGATEWAY_ENTERPRISE_LICENSE — unset; running without the enterprise/ee
#                       admin surface.
# ONBOARDING_SPONSOR_SECRET     — unset; first calls bill normally.

# AGPL source offer: URL of the public repo holding this deployment's
# corresponding source (generated by infra/export-public-source.sh). The UI
# footer links here.
GITHUB_URL=https://github.com/vicharai/api

# -----------------------------------------------------------------------------
# Ops (read by host-side scripts, not by the app)
# -----------------------------------------------------------------------------
# Discord webhook for deploy/rollback/backup status posts. Optional — scripts
# log instead when unset. Host-side read via envfile_get, so no quoting needed.
# VICHAR_OPS_DISCORD_WEBHOOK=
