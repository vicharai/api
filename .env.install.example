# =============================================================================
# Vichar — server install configuration (read by ./install.sh)
#
#   cp .env.install.example .env && chmod 600 .env
#   $EDITOR .env           # fill in the values marked REQUIRED
#   sudo ./install.sh      # see ./install.sh help for other commands
#
# Values are read literally. Quote a value with single quotes if it contains
# spaces, '#' or '$'. Leave a secret empty to have install.sh generate it —
# the generated value is written back here, so keep this file backed up:
# changing AUTH_SECRET logs everyone out, changing
# GATEWAY_API_KEY_HASH_SECRET invalidates every issued API key.
# =============================================================================

# -----------------------------------------------------------------------------
# Install mode
# -----------------------------------------------------------------------------
# production  — Docker images built from this checkout, nginx + Let's Encrypt
#               TLS, firewall, auto-restart. Use for live servers.
# development — native Node.js with hot reload (`pnpm dev` as the systemd
#               service vichar-dev), Redis in Docker, nginx over HTTP (TLS
#               optional). Use for staging/dev servers.
DEPLOY_MODE=production

# -----------------------------------------------------------------------------
# Domains (REQUIRED) — point A records for all four at this server first.
# -----------------------------------------------------------------------------
# Base (registrable) domain; cookies and passkeys are scoped to it.
BASE_DOMAIN=example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
DOCS_DOMAIN=docs.example.com

# TLS via Let's Encrypt (certbot). Default: true in production, false in
# development. LETSENCRYPT_EMAIL is REQUIRED when TLS is enabled.
ENABLE_TLS=
LETSENCRYPT_EMAIL=ops@example.com

# Open only SSH/80/443 with ufw (default true in production).
CONFIGURE_FIREWALL=

# -----------------------------------------------------------------------------
# Database — external PostgreSQL (AWS RDS / Aurora). REQUIRED.
# -----------------------------------------------------------------------------
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
# RDS: use sslmode=verify-full; install.sh installs the AWS RDS CA bundle.
# The database is created if it does not exist and the user may create it.
DATABASE_URL=postgres://vichar:CHANGE_ME@your-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/vichar?sslmode=verify-full
# Pool size per process (api, gateway and worker each open one pool).
# DATABASE_POOL_MAX=20

# -----------------------------------------------------------------------------
# Redis — runs on this server in Docker. Leave empty to generate.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=
# Max memory for Redis (no eviction: it holds the billing queue).
REDIS_MAXMEMORY=1gb

# -----------------------------------------------------------------------------
# Auth & admin
# -----------------------------------------------------------------------------
# Leave empty to generate (openssl rand -base64 32).
AUTH_SECRET=
GATEWAY_API_KEY_HASH_SECRET=

# REQUIRED. Comma-separated owner admins for the admin panel. Sign up with
# one of these addresses, then run: sudo ./install.sh verify-admin <email>
ADMIN_EMAILS=admin@example.com

PASSKEY_RP_NAME=Vichar
SSO_ENABLED=false
TELEMETRY_ACTIVE=false

# -----------------------------------------------------------------------------
# LLM providers — set at least one real key.
# -----------------------------------------------------------------------------
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CLOUDFLARE_API_KEY=
LLM_AWS_BEDROCK_API_KEY=
# LLM_AWS_BEDROCK_REGION=us-east-1

# Restrict the public catalogue to curated entries (empty = full catalogue).
GATEWAY_MODEL_ALLOWLIST=vichar-*

# -----------------------------------------------------------------------------
# Optional integrations (leave unset to keep them off)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Vichar <noreply@example.com>
# DODO_PAYMENTS_API_KEY=
# GITHUB_URL=https://github.com/vicharai/api
EMAIL_FOLLOW_UPS=false

# -----------------------------------------------------------------------------
# Advanced — derived automatically when empty
# -----------------------------------------------------------------------------
# UI_URL / APP_URL / API_URL / GATEWAY_URL / DOCS_URL / ADMIN_URL,
# ORIGIN_URLS, GATEWAY_CORS_ORIGINS, COOKIE_DOMAIN, PASSKEY_RP_ID.
# STACK_NAME=vichar
